	fragment@57 {
		target = <0xffffffff>;

		__overlay__ {

			pmx_sdc3_clk {

				sdc3_clk_on {
					phandle = <0x2b>;

					mux {
						pins = "gpio79";
						function = "sdc3_clk";
					};

					config {
						pins = "gpio79";
						drive-strength = <0x08>;
						bias-disable;
					};
				};

				sdc3_clk_off {
					phandle = <0x2e>;

					mux {
						pins = "gpio79";
						function = "sdc3_clk";
					};

					config {
						pins = "gpio79";
						bias-disable;
						drive-strength = <0x02>;
					};
				};
			};

			pmx_sdc3_cmd {

				sdc3_cmd_on {
					phandle = <0x2c>;

					mux {
						pins = "gpio78";
						function = "sdc3_cmd";
					};

					config {
						pins = "gpio78";
						bias-pull-up;
						drive-strength = <0x04>;
					};
				};

				sdc3_cmd_off {
					phandle = <0x2f>;

					mux {
						pins = "gpio78";
						function = "sdc3_cmd";
					};

					config {
						pins = "gpio78";
						bias-pull-up;
						drive-strength = <0x02>;
					};
				};
			};

			pmx_sdc3_data {

				sdc3_data_on {
					phandle = <0x2d>;

					mux {
						pins = "gpio74", "gpio75", "gpio76", "gpio77";
						function = "sdc3_data";
					};

					config {
						pins = "gpio74", "gpio75", "gpio76", "gpio77";
						bias-pull-up;
						drive-strength = <0x04>;
					};
				};

				sdc3_data_off {
					phandle = <0x30>;

					mux {
						pins = "gpio74", "gpio75", "gpio76", "gpio77";
						function = "sdc3_data";
					};

					config {
						pins = "gpio74", "gpio75", "gpio76", "gpio77";
						bias-pull-up;
						drive-strength = <0x02>;
					};
				};
			};
		};
	};

