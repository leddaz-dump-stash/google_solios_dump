	fragment@86 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,fv-max-uv = "", "D\\";
			qcom,usb-icl-ua = <0x927c0>;
			qcom,fcc-max-ua = <0x7a120>;
		};
	};

	fragment@87 {
		target = <0xffffffff>;

		__overlay__ {
			qcom,iterm-ma = <0x14>;
		};
	};

	mcu_root {
		target-path = "/";

		__overlay__ {

			mcu {
				board_type = "luna_evt1";
				phandle = <0x57>;
			};
		};
	};

	fragment@88 {
		target = <0xffffffff>;

		__overlay__ {

			mcu_display {
				compatible = "google,mcu_display";
				display_pins,display-mux-select-gpio = <0xffffffff 0x23 0x00>;
				phandle = <0x58>;
			};

			gpiochipwake0 {
				compatible = "google,gpiochipwake0";
				mcu-pins,crash-gpios = <0xffffffff 0x13 0x00>;
				phandle = <0x59>;
			};
		};
	};

	fragment@89 {
		target = <0xffffffff>;

		__overlay__ {

			display_pins {

				display-mux-select {
					phandle = <0x5a>;

					mux {
						pins = "gpio35";
						function = "gpio";
					};

					config {
						pins = "gpio35";
						drive-strength = <0x06>;
						bias-disable;
						output-high;
					};
				};
			};

			mcu-pins {

				crash {

					mux {
						pins = "gpio19";
						function = "gpio";
					};

					config {
						pins = "gpio19";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};
			};
		};
	};

	fragment@90 {
		target = <0xffffffff>;

		__overlay__ {

			wlan_pins {

				wl-reg-on {
					phandle = <0x48>;

					mux {
						pins = "gpio33";
						function = "gpio";
					};

					config {
						pins = "gpio33";
						drive-strength = <0x02>;
						bias-disable;
						output-low;
					};
				};

				wl-dev-wake {
					phandle = <0x49>;

					mux {
						pins = "gpio42";
						function = "gpio";
					};

					config {
						pins = "gpio42";
						drive-strength = <0x02>;
						bias-disable;
						output-low;
					};
				};

				wl-host-wake {
					phandle = <0x4a>;

					mux {
						pins = "gpio8";
						function = "gpio";
					};

					config {
						pins = "gpio8";
						drive-strength = <0x02>;
						bias-pull-down;
						input-enable;
					};
				};
			};
		};
	};

	fragment@91 {
		target = <0xffffffff>;

		__overlay__ {

			wlan-gpios {
				status = "ok";
				compatible = "android,syna_wlan";
				wl_reg_on = <0xffffffff 0x21 0x00>;
				wl_host_wake = <0xffffffff 0x08 0x00>;
				wl_dev_wake = <0xffffffff 0x2a 0x00>;
				pinctrl-names = "default";
				pinctrl-0 = <0x48 0x49 0x4a>;
				phandle = <0x5b>;
			};
		};
	};

