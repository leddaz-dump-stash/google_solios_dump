on boot
    chmod 0660 /sys/bus/platform/devices/4a94000.qcom,qup_uart/hs_uart_operation
    chown bluetooth bluetooth /sys/bus/platform/devices/4a94000.qcom,qup_uart/hs_uart_operation

service pixel_watch /vendor/bin/hw/android.hardware.bluetooth-service.pixel_watch
    class hal
    user bluetooth
    group bluetooth net_admin net_bt_admin system context_hub
    capabilities NET_ADMIN WAKE_ALARM
